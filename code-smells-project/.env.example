# Copie para .env e preencha. O arquivo .env esta no .gitignore.
# Nenhum valor real deve ser versionado aqui.

# Obrigatorio: sem esta variavel a aplicacao nao sobe (fail fast).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Servidor. DEBUG=true e aceito apenas com HOST=127.0.0.1.
DEBUG=false
HOST=127.0.0.1
# 5001: no macOS a 5000 e do AirPlay Receiver
PORT=5001

# Banco de dados
DATABASE_PATH=loja.db
SEED_ON_BOOT=true

# Observabilidade
LOG_LEVEL=INFO

# Fronteira HTTP
CORS_ORIGINS=http://localhost:3000
MAX_CONTENT_LENGTH=102400

# Autenticacao
TOKEN_TTL_SECONDS=3600

# Limite de requisicoes por minuto
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=20
ADMIN_RATE_LIMIT=60

# Paginacao
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
