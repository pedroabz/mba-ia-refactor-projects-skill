tests {
  test("status 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("envelope de erro", function() {
    expect(res.body.sucesso).to.equal(false);
    expect(res.body.erro).to.be.a("string");
  });
}

