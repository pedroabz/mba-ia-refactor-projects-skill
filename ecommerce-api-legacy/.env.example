# Copy to .env and fill in. Never commit .env.
# Values present in the real environment always win over this file.

NODE_ENV=development

# --- HTTP -------------------------------------------------------------------
PORT=3100
HOST=127.0.0.1
HTTP_BODY_LIMIT=100kb

# --- Database ---------------------------------------------------------------
# ':memory:' rebuilds the schema and seeds on every boot and persists nothing.
# Point at a file path to keep data between restarts.
DATABASE_FILE=:memory:

# --- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug

# --- Secrets ----------------------------------------------------------------
# Required in production: the application refuses to start without them.
# Outside production, a missing secret is replaced by a random value generated for that
# process — so there is no known fallback, and tokens simply do not survive a restart.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# --- Payments ---------------------------------------------------------------
# 'stub' approves any card beginning with 4 without contacting a provider. It is the
# original hardcoded rule, isolated behind a port, and production refuses to use it.
PAYMENT_DRIVER=stub
PAYMENT_GATEWAY_KEY=

# --- Mail -------------------------------------------------------------------
MAIL_SENDER=no-reply@example.invalid

# --- Development fixtures ---------------------------------------------------
# Seeding is refused in production. These are fixture passwords for the two seeded
# accounts (leonan@fullcycle.com.br, admin@fullcycle.com.br), not secrets.
SEED_ENABLED=true
SEED_STUDENT_PASSWORD=dev-student-password
SEED_ADMIN_PASSWORD=dev-admin-password

# --- Report pagination ------------------------------------------------------
REPORT_DEFAULT_PAGE_SIZE=50
REPORT_MAX_PAGE_SIZE=200
REPORT_MAX_STUDENTS_PER_COURSE=200

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_ADMIN_MAX=30
