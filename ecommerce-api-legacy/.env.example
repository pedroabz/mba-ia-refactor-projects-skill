# Copy to .env and fill in. Never commit .env.
# Values present in the real environment always win over this file.

NODE_ENV=development

# --- HTTP -------------------------------------------------------------------
PORT=3100
HOST=127.0.0.1
HTTP_BODY_LIMIT=100kb

# --- Database ---------------------------------------------------------------
# ':memory:' rebuilds the schema and seeds on every boot and persists nothing.
# Point at a file path to keep data between restarts.
DATABASE_FILE=:memory:

# --- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug

# --- Secrets ----------------------------------------------------------------
# Required in production: the application refuses to start without them.
# Outside production, a missing secret is replaced by a random value generated for that
# process — so there is no known fallback, and tokens simply do not survive a restart.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# --- Payments ---------------------------------------------------------------
# 'stub' contacts no provider, so it cannot authorize a payment: every charge is
# declined with 402. Production refuses to use it at all. Replacing it means writing an
# adapter that calls a real provider and registering it in services/payment.gateway.js.
PAYMENT_DRIVER=stub
#
# Ignored while PAYMENT_DRIVER=stub — nothing reads it, because nothing here contacts a
# provider. It is kept so the variable name is already in place for a real adapter; the
# application warns at boot if it is set against the stub, so a key here is never mistaken
# for a working gateway.
PAYMENT_GATEWAY_KEY=
#
# Makes the stub approve instead of decline, for developing the flow that follows a
# successful payment. Honoured only when NODE_ENV=development, and off unless set.
# Leave it unset unless you are deliberately testing the success path: with it on, any
# valid-looking card number buys a course without a provider ever being contacted.
PAYMENT_STUB_APPROVE=false

# --- Mail -------------------------------------------------------------------
MAIL_SENDER=no-reply@example.invalid

# --- Development fixtures ---------------------------------------------------
# Seeding is refused in production, and on by default everywhere else — so set
# SEED_ENABLED=false on any shared deployment you do not want fixture accounts in.
SEED_ENABLED=true
#
# Passwords for the two seeded accounts (leonan@fullcycle.com.br,
# admin@fullcycle.com.br). The application has no default for these: leave them unset
# and the seeder generates a random password per process and logs it at boot, so a
# deployment that forgets them does not get a known administrator.
#
# The values below are suggested for a local copy of this file only — `api.http`, the
# Bruno collection and docs/manual-test-plan.md expect them. Copying a template on
# purpose is not the same as an application defaulting to a literal: delete them on any
# shared host and let the random ones be generated.
SEED_STUDENT_PASSWORD=dev-student-password
SEED_ADMIN_PASSWORD=dev-admin-password

# --- Report pagination ------------------------------------------------------
REPORT_DEFAULT_PAGE_SIZE=50
REPORT_MAX_PAGE_SIZE=200
REPORT_MAX_STUDENTS_PER_COURSE=200

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_ADMIN_MAX=30
