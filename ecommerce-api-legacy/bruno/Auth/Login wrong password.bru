meta {
  name: Login wrong password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "senha-errada"
  }
}

tests {
  test("401 unauthorized", function() {
    expect(res.status).to.equal(401);
    expect(res.body.error.code).to.equal("unauthorized");
  });
}

docs {
  401 genérico. Compare o corpo com **Login unknown email**: as duas respostas são
  idênticas de propósito, para que a API não revele se um e-mail está cadastrado.
}
