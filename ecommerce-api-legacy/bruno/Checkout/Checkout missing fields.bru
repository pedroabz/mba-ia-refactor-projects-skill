meta {
  name: Checkout missing fields
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("400 nomeando cada campo que falta", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.code).to.equal("validation_error");
    expect(res.body.error.details).to.have.all.keys(
      "name", "email", "password", "courseId", "cardNumber"
    );
  });
}

docs {
  Antes: `400 "Bad Request"` em texto puro, sem dizer o que faltava. Agora o
  `details` nomeia cada campo, então o cliente consegue tratar a falha
  programaticamente (API-03, API-05).
}
