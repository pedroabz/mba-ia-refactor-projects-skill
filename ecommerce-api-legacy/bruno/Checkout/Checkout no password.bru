meta {
  name: Checkout no password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Sem Senha",
    "email": "sem-senha@teste.com",
    "courseId": 2,
    "cardNumber": "{{approvedCard}}"
  }
}

tests {
  test("400 — senha é obrigatória, nunca defaultada", function() {
    expect(res.status).to.equal(400);
    expect(res.body.error.details.password).to.equal("é obrigatório");
  });
}

docs {
  **Mudança intencional de contrato.** Esta requisição respondia `200` e criava a
  conta com a senha `"123456"`, escrita direto no código. Um campo relevante para
  segurança nunca deve ser silenciosamente defaultado (SEC-04).
}
