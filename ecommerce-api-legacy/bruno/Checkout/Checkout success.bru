meta {
  name: Checkout success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/checkout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Guilherme",
    "email": "gui@fullcycle.com.br",
    "password": "senhaforte",
    "courseId": 2,
    "cardNumber": "{{approvedCard}}"
  }
}

tests {
  test("201 Created com o recurso criado", function() {
    expect(res.status).to.equal(201);
    expect(res.body.enrollmentId).to.be.a("number");
    expect(res.body.courseId).to.equal(2);
    expect(res.body.amount).to.equal(497);
    expect(res.body.status).to.equal("PAID");
  });

  test("Location aponta para a matrícula criada", function() {
    expect(res.headers.location).to.equal("/api/enrollments/" + res.body.enrollmentId);
  });
}

docs {
  Rota pública: cria usuário (se o e-mail for novo), matrícula, pagamento e a linha
  de auditoria **em uma única transação**. Antes eram quatro escritas sem fronteira
  transacional, e uma falha no meio deixava estado parcial comitado — matrícula sem
  pagamento, isto é, acesso ao curso sem cobrança registrada (DAT-01).

  Resposta era `200 {"msg":"Sucesso","enrollment_id":n}`; agora é `201` com
  `Location` e os campos nomeados (API-05).

  Nomes canônicos: `name`, `email`, `password`, `courseId`, `cardNumber`.
}
