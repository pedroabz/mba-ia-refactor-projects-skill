# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# SECRET_KEY is required and has no default — the boot fails without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Persistence
DATABASE_URL=sqlite:///tasks.db
SQLALCHEMY_ECHO=false

# Runtime. DEBUG=true is refused on any non-loopback HOST: the Werkzeug
# debugger executes arbitrary code submitted through the browser.
DEBUG=false
HOST=127.0.0.1
# 6000, not 5000: on macOS the AirPlay Receiver holds 5000, and the other
# projects in this repository use it too. Note that browsers block port 6000
# (it is X11's) with ERR_UNSAFE_PORT — curl, Bruno and any HTTP client are
# unaffected, but a browser front-end needs a different port (6001, 8000).
PORT=6000

# HTTP boundary
CORS_ORIGINS=http://localhost:3000
MAX_CONTENT_LENGTH_BYTES=262144
TOKEN_TTL_SECONDS=3600

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Observability
LOG_LEVEL=INFO
