meta {
  name: Listar users como user comum (403)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("responde 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  Requer *Login (user)* corrido antes, para popular `{{userToken}}`.

  Distingue 401 de 403: autenticado mas sem permissão.
}
