      "path": "/produtos/1"
    },
    {
      "id": "produtos-search-term",
      "method": "GET",
      "path": "/produtos/busca?q=mouse"
    },
    {
      "id": "produtos-search-filter",
      "method": "GET",
      "path": "/produtos/busca?categoria=informatica&preco_min=100&preco_max=2000"
    },
    {
      "id": "usuarios-list",
      "method": "GET",
      "path": "/usuarios",
      "auth": true
    },
    {
